# Any OpenAI-compatible endpoint works. Ollama exposes one at http://localhost:11434/v1
RAGKIT_LLM_BASE_URL=https://api.openai.com/v1
RAGKIT_LLM_API_KEY=sk-...
RAGKIT_LLM_MODEL=gpt-4o-mini

# Embeddings: "hash" (offline, for tests only), "openai" (any OpenAI-compatible /embeddings), or "ollama"
RAGKIT_EMBED_PROVIDER=hash
RAGKIT_EMBED_MODEL=text-embedding-3-small
RAGKIT_EMBED_BASE_URL=https://api.openai.com/v1
RAGKIT_EMBED_API_KEY=sk-...

# Reranker: "none" or "cross-encoder" (needs the [rerank] extra)
RAGKIT_RERANKER=none
RAGKIT_RERANK_MODEL=BAAI/bge-reranker-base

# Contextual retrieval at ingest time (one LLM call per chunk, costs money, improves recall)
RAGKIT_CONTEXTUALIZE=false

RAGKIT_DB_PATH=./data/ragkit.db
RAGKIT_AUDIT_PATH=./data/audit.jsonl
